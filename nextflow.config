// enable DSL2
nextflow.enable.dsl = 2

/* quick test (local docker):
   nextflow run main.nf \
     --verbose \
     --samples "test_samples/*.fasta" \
     --outdir "results_test" \
     -profile docker
*/

/* Working Call: # TAG=aws-preprocess-fix-20250822-0339
   nextflow run main.nf \
  --verbose \
  --samples "s3://ach-covid-lasso-us-east-2/inputs/test_samples/*.fasta" \
  --outdir "s3://ach-covid-lasso-us-east-2/results_test" \
  -profile aws_high_mem_debug \
  --container_tag $TAG \
  --reference_fasta "s3://ach-covid-lasso-us-east-2/inputs/reference/NC_045512.2_sequence.fasta" \
  --train_feature_matrix "s3://ach-covid-lasso-us-east-2/inputs/lasso/feature_matrix_train.csv" \
  --model "s3://ach-covid-lasso-us-east-2/inputs/model/lasso_model.joblib" \
  --scaler "s3://ach-covid-lasso-us-east-2/inputs/model/scaler.joblib"
*/

// ---- Container selectors for flexible image selection ----
params.container_tag    = null      // e.g. --container_tag aws-preprocess-fix-20250822-0339
params.container_digest = null      // e.g. --container_digest f6349eaf... (NO "sha256:" prefix)
def ECR_URI = '802861900950.dkr.ecr.us-east-2.amazonaws.com/covid-lasso'
// ---------------------------------------------------------

// Parameters
params {
  // S3 bucket (can be overridden with --bucket parameter)
  bucket                = "ach-covid-lasso-us-east-2"

  // Default file paths (can be overridden individually)
  reference_fasta       = "raw_data/NC_045512.2_sequence.fasta"
  train_feature_matrix  = "lasso_training_data/feature_matrix_train.csv"
  model                 = "model_artifacts/lasso_model.joblib"
  scaler                = "model_artifacts/scaler.joblib"

  // Pipeline parameters
  chunk_size            = 10
  identity_thresh       = 92.0
  verbose               = false
}

process {
  executor = 'local'
  maxForks = 10
}

/* ---------- Conda baseline ---------- */
conda {
  enabled  = true
  useMamba = true
}

plugins { id 'nf-amazon' }

profiles {
  standard {
    conda.enabled  = true
    conda.useMamba = true
  }

  aws {
    process {
      executor = 'awsbatch'
      maxForks = 50
    }
    conda.enabled  = true
    conda.useMamba = true
  }

  /* ---------- Local Docker profile ---------- */
  docker {
    docker.enabled    = true
    docker.runOptions = '-u $(id -u):$(id -g)'  // avoid root-owned outputs
    conda.enabled     = false                   // containers supply the env
    process.container = 'covid-lasso:latest'
    docker.pull       = true
  }

  /* ---------- AWS Batch + Docker (Production) ---------- */
  aws_docker {
    // AWS + S3 configuration
    aws.region = 'us-east-2'
    workDir    = 's3://ach-covid-lasso-us-east-2/work'

    // Container runtime
    docker.enabled = true
    conda.enabled  = false

    // Batch executor configuration
    process {
      executor = 'awsbatch'
      queue    = 'nf-ec2'  // Your EC2 job queue
      maxForks = 30

      // Flexible container selection: prefer digest, else tag, else latest
      container = params.container_digest ? "${ECR_URI}@sha256:${params.container_digest}"
               : params.container_tag    ? "${ECR_URI}:${params.container_tag}"
                                         : "${ECR_URI}:latest"

      // Resource requirements for MAFFT alignment
      cpus   = 16
      memory = '64 GB'  // Sufficient memory for MAFFT
      time   = '2h'

      // Error handling
      errorStrategy = 'retry'
      maxRetries    = 2

      // Container environment setup
      shell = ['/bin/bash', '-euo', 'pipefail']
      beforeScript = '''
        # Ensure proper environment for Nextflow execution
        export PATH=/opt/conda/bin:/usr/local/bin:/usr/bin:/bin:$PATH
        export LANG=C.UTF-8
        export LC_ALL=C.UTF-8

        # IMPORTANT: Unset MAFFT_BINARIES to avoid configuration conflicts
        unset MAFFT_BINARIES || true

        # Create necessary directories if they don't exist
        mkdir -p /tmp

        # Verify essential commands are available
        which bash || echo "WARNING: bash not found in PATH"
        which python3 || echo "WARNING: python3 not found in PATH"
        which mafft || echo "WARNING: mafft not found in PATH"
      '''
    }

    // AWS Batch configuration
    aws.batch.jobRole      = 'arn:aws:iam::802861900950:role/covid-lasso-job-role'
    aws.batch.platformType = 'EC2'
    aws.batch.logsGroup    = '/aws/batch/job'
    aws.batch.retryMode    = 'standard'
    aws.batch.maxTransferAttempts = 3
    aws.batch.delayBetweenAttempts = '30 sec'
  }

  /* ---------- AWS Batch Debug Profile ---------- */
  aws_debug {
    // AWS + S3 configuration
    aws.region = 'us-east-2'
    workDir    = 's3://ach-covid-lasso-us-east-2/work'

    // Container runtime
    docker.enabled = true
    conda.enabled  = false

    // Debug settings - process one job at a time
    process {
      executor = 'awsbatch'
      queue    = 'nf-ec2'
      maxForks = 1  // One job at a time for debugging

      // Container selection
      container = params.container_digest ? "${ECR_URI}@sha256:${params.container_digest}"
               : params.container_tag    ? "${ECR_URI}:${params.container_tag}"
                                         : "${ECR_URI}:latest"

      // Increased memory for MAFFT alignment debugging
      cpus   = 2
      memory = '8 GB'  // High memory for debugging MAFFT issues
      time   = '1h'

      // Stop on first error for debugging
      errorStrategy = 'terminate'
      maxRetries    = 0

      // Container environment setup with debugging
      shell = ['/bin/bash', '-euo', 'pipefail']
      beforeScript = '''
        # Comprehensive environment setup for debugging
        echo "=== CONTAINER ENVIRONMENT SETUP ==="
        export PATH=/opt/conda/bin:/usr/local/bin:/usr/bin:/bin:$PATH
        export LANG=C.UTF-8
        export LC_ALL=C.UTF-8

        # IMPORTANT: Unset MAFFT_BINARIES to avoid configuration conflicts
        unset MAFFT_BINARIES || true

        # Create necessary directories
        mkdir -p /tmp

        echo "PATH: $PATH"
        echo "Available memory:"
        free -h || echo "free command not available"
        echo "Available disk space:"
        df -h || echo "df command not available"
        echo "Available tools:"
        which python3 || echo "python3 not found"
        which mafft || echo "mafft not found"
        mafft --version || echo "mafft version check failed"
        echo "MAFFT_BINARIES: ${MAFFT_BINARIES:-'(unset)'}"
        echo "Current user: $(whoami)"
        echo "Current directory: $(pwd)"
        echo "=== END ENVIRONMENT SETUP ==="
      '''
    }

    // AWS Batch configuration
    aws.batch.jobRole      = 'arn:aws:iam::802861900950:role/covid-lasso-job-role'
    aws.batch.platformType = 'EC2'
    aws.batch.logsGroup    = '/aws/batch/job'
    aws.batch.retryMode    = 'standard'
  }

  /* ---------- High Memory Debug Profile ---------- */
  aws_high_mem_debug {
    // AWS + S3 configuration
    aws.region = 'us-east-2'
    workDir    = 's3://ach-covid-lasso-us-east-2/work'

    // Container runtime
    docker.enabled = true
    conda.enabled  = false

    // High memory settings for large alignments
    process {
      executor = 'awsbatch'
      queue    = 'nf-ec2'
      maxForks = 10

      // Container selection
      container = params.container_digest ? "${ECR_URI}@sha256:${params.container_digest}"
               : params.container_tag    ? "${ECR_URI}:${params.container_tag}"
                                         : "${ECR_URI}:latest"

      // High memory allocation for large sequence alignments
      cpus   = 12
      memory = '20 GB'  // Very high memory for problematic alignments
      time   = '2h'

      // Stop on first error for debugging
      errorStrategy = 'terminate'
      maxRetries    = 0

      // Container environment setup
      shell = ['/bin/bash', '-euo', 'pipefail']
      beforeScript = '''
        echo "=== HIGH MEMORY DEBUG SETUP ==="
        export PATH=/opt/conda/bin:/usr/local/bin:/usr/bin:/bin:$PATH
        export LANG=C.UTF-8
        export LC_ALL=C.UTF-8

        # IMPORTANT: Unset MAFFT_BINARIES to avoid configuration conflicts
        unset MAFFT_BINARIES || true

        echo "Allocated CPUs: 8"
        echo "Allocated Memory: 16 GB"
        echo "Available memory:"
        free -h || echo "free command not available"
        echo "MAFFT version and configuration:"
        mafft --version || echo "mafft version check failed"
        echo "MAFFT_BINARIES: ${MAFFT_BINARIES:-'(unset)'}"
        echo "=== END HIGH MEMORY SETUP ==="
      '''
    }

    // AWS Batch configuration
    aws.batch.jobRole      = 'arn:aws:iam::802861900950:role/covid-lasso-job-role'
    aws.batch.platformType = 'EC2'
    aws.batch.logsGroup    = '/aws/batch/job'
    aws.batch.retryMode    = 'standard'
  }

 /* ---------- Minimal Working Test Profile ---------- */
  aws_minimal_working {
    // AWS + S3 configuration
    aws.region = 'us-east-2'
    workDir    = 's3://ach-covid-lasso-us-east-2/work'

    // Container runtime
    docker.enabled = true
    conda.enabled  = false

    // Minimal settings that should work
    process {
      executor = 'awsbatch'
      queue    = 'nf-ec2'
      maxForks = 1

      // Container selection
      container = params.container_digest ? "${ECR_URI}@sha256:${params.container_digest}"
               : params.container_tag    ? "${ECR_URI}:${params.container_tag}"
                                         : "${ECR_URI}:latest"

      // Conservative resource allocation
      cpus   = 4
      memory = '16 GB'  // Use the memory amount we know works
      time   = '2h'

      // Allow retries but terminate on persistent failures
      errorStrategy = 'retry'
      maxRetries    = 1

      // Simplified container environment setup
      shell = ['/bin/bash', '-euo', 'pipefail']
      beforeScript = '''
        echo "=== MINIMAL WORKING SETUP ==="
        export PATH=/opt/conda/bin:/usr/local/bin:/usr/bin:/bin:$PATH
        export LANG=C.UTF-8
        export LC_ALL=C.UTF-8

        # Unset MAFFT_BINARIES
        unset MAFFT_BINARIES || true

        # Create temp directory
        mkdir -p /tmp

        echo "CPUs: 4, Memory: 16GB"
        echo "Python: $(python3 --version 2>&1 || echo 'not found')"
        echo "MAFFT: $(mafft --version 2>&1 | head -1 || echo 'not found')"
        echo "Working directory: $(pwd)"
        echo "Available files: $(ls -1 | wc -l) files"
        echo "=== END MINIMAL SETUP ==="
      '''
    }

    // AWS Batch configuration
    aws.batch.jobRole      = 'arn:aws:iam::802861900950:role/covid-lasso-job-role'
    aws.batch.platformType = 'EC2'
    aws.batch.logsGroup    = '/aws/batch/job'
    aws.batch.retryMode    = 'standard'
  }

  /* ---------- Container Environment Test Profile ---------- */
  aws_env_test {
    // AWS + S3 configuration
    aws.region = 'us-east-2'
    workDir    = 's3://ach-covid-lasso-us-east-2/work'

    // Container runtime
    docker.enabled = true
    conda.enabled  = false

    // Test settings
    process {
      executor = 'awsbatch'
      queue    = 'nf-ec2'
      maxForks = 1

      // Container selection
      container = params.container_digest ? "${ECR_URI}@sha256:${params.container_digest}"
               : params.container_tag    ? "${ECR_URI}:${params.container_tag}"
                                         : "${ECR_URI}:latest"

      // Resource requirements
      cpus   = 1
      memory = '2 GB'
      time   = '15m'

      // Stop on error for testing
      errorStrategy = 'terminate'
      maxRetries    = 0

      // Container environment setup with comprehensive testing
      shell = ['/bin/bash', '-euo', 'pipefail']
      beforeScript = '''
        echo "=== COMPREHENSIVE CONTAINER TEST ==="

        # Basic environment
        export PATH=/opt/conda/bin:/usr/local/bin:/usr/bin:/bin:$PATH
        export LANG=C.UTF-8
        export LC_ALL=C.UTF-8

        # IMPORTANT: Unset MAFFT_BINARIES to avoid configuration conflicts
        unset MAFFT_BINARIES || true

        echo "Operating System:"
        cat /etc/os-release || echo "OS info not available"

        echo "Available shells:"
        ls -la /bin/*sh* || true

        echo "PATH: $PATH"
        echo "Current user: $(whoami)"
        echo "Current directory: $(pwd)"
        echo "Home directory: $HOME"

        echo "Python installations:"
        which python3 || echo "python3 not in PATH"
        which python || echo "python not in PATH"
        python3 --version || echo "python3 version check failed"
        python --version || echo "python version check failed"

        echo "MAFFT installation:"
        which mafft || echo "mafft not found"
        mafft --version || echo "mafft version check failed"
        echo "MAFFT_BINARIES: ${MAFFT_BINARIES:-'(unset)'}"

        echo "Conda info:"
        which conda || echo "conda not found"
        conda --version || echo "conda version check failed"

        echo "Directory contents:"
        ls -la

        echo "Environment variables:"
        env | grep -E "(PATH|PYTHON|CONDA|HOME|LANG)" || true

        echo "Available disk space:"
        df -h || echo "df command failed"

        echo "Memory info:"
        free -h || echo "free command failed"

        echo "=== END COMPREHENSIVE TEST ==="
      '''
    }

    // AWS Batch configuration
    aws.batch.jobRole      = 'arn:aws:iam::802861900950:role/covid-lasso-job-role'
    aws.batch.platformType = 'EC2'
    aws.batch.logsGroup    = '/aws/batch/job'
    aws.batch.retryMode    = 'standard'
  }
}