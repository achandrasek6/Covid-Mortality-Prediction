# Docker Hub official images mirrored on AWS Public ECR
FROM public.ecr.aws/docker/library/python:3.11-slim

# Set a non-root user
RUN useradd -m -u 10001 appuser

WORKDIR /app

# System deps (optional: faster wheels, uv loop perf)
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY app/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy app code
COPY app/ /app/

# Security: drop to non-root
USER appuser

# Expose the port your service will listen on (ECS uses this)
ENV PORT=8080
EXPOSE 8080

# Healthcheck (optional but good for ECS target group)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:' + __import__('os').environ.get('PORT','8080') + '/health').read()"

# Start uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
